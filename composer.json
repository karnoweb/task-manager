{
  "name": "karnoweb/task-manager",
  "description": "Independent Laravel task and workflow engine",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/events": "^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Karnoweb\\TaskManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Karnoweb\\TaskManager\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Karnoweb\\TaskManager\\TaskManagerServiceProvider"
      ],
      "aliases": {
        "TaskManager": "Karnoweb\\TaskManager\\Facades\\TaskManager"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "suggest": {
    "ext-intl": "Required for Persian/Jalali recurrence; enables Unicode normalization.",
    "ext-curl": "Required by the default pinned HTTPS webhook transport."
  }
}
